# Xiaomi MiMo Token/Coding Plan.
# Pick the cluster shown on your MiMo subscription page if different.
MIMO_TOKEN_PLAN_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_TOKEN_PLAN_KEY=tp-your-mimo-token-plan-key
MIMO_TOKEN_PLAN_MODEL=mimo-v2.5-pro

# Optional Xiaomi pay-as-you-go API. Use only when you have a separate API key.
# MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_API_KEY=sk-your-mimo-api-key
# MIMO_API_MODEL=mimo-v2.5

# Volcengine Ark.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your-volcengine-ark-api-key
ARK_PAYG_API_KEY=your-volcengine-ark-pay-as-you-go-api-key
ARK_MODEL=doubao-seed-2-0-lite-260215

# DeepSeek pay-as-you-go API.
DS_PAYG_API_KEY=your-deepseek-pay-as-you-go-api-key

# AGNES free fallback.
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=your-agnes-api-key
AGNES_MODEL=agnes-2.0-flash

# OpenRouter free fallback.
# The default model uses OpenRouter's Free Models Router.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_KEY_2=your-second-openrouter-api-key
OPENROUTER_FREE_MODEL=openrouter/free

# Daily model evaluation.
TAVILY_API_KEY=tvly-your-tavily-api-key
# DAILY_EVAL_MAX_TOKENS=100000
# DAILY_EVAL_CONCURRENCY=4
